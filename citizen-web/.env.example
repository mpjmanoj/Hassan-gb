# Google Maps Platform — Maps JavaScript API key (restrict by HTTP referrer).
# Leave empty during design work: the app falls back to an offline schematic map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase (not wired yet — frontend currently runs on the mock data layer).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Data source for the app: "mock" (default) or "supabase" (once the backend exists).
NEXT_PUBLIC_DATA_SOURCE=mock
