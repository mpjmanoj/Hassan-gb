# Copy this file to .env.local and fill it in. .env.local is git-ignored — never commit keys.

# Supabase → Project Settings → API
# The URL is your project's public address; the anon key is the browser key. Both are meant
# to be visible in the browser: Row Level Security is what protects the data, not secrecy.
# NEVER put the service_role key in this file — anything NEXT_PUBLIC_ is shipped to visitors.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps Platform — Maps JavaScript API key, restricted by HTTP referrer.
# Leave empty and the app falls back to a labelled schematic map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# "demo" runs on the in-browser store; "supabase" once the backend is wired up.
NEXT_PUBLIC_DATA_SOURCE=demo
